          "CREATE TRIGGER runtime_artifact_file_guard BEFORE INSERT OR DELETE OR UPDATE ON runtime_artifact_file FOR EACH ROW EXECUTE FUNCTION runtime_guard_artifact_file()",
          "DECLARE current_state text; BEGIN SELECT state INTO current_state FROM runtime_artifact_set WHERE set_id=CASE WHEN TG_OP='DELETE' THEN OLD.set_id ELSE NEW.set_id END FOR UPDATE; IF TG_OP='INSERT' AND current_state='STAGING' THEN RETURN NEW; END IF; IF TG_OP='DELETE' AND current_state='DELETING' THEN RETURN OLD; END IF; RAISE EXCEPTION 'Artifact file mutation is not permitted in state %', current_state; END"
